<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PlaybackCard</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaybackCard</AssemblyName>
    <Version>0.2.7.6</Version>
    <AssemblyVersion>0.2.7.6</AssemblyVersion>
    <FileVersion>0.2.7.6</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <NoWarn>$(NoWarn);CA1724;CA1056;NU1900</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;scratch\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Jellyfin Server Dependencies -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.9.11">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App">
      <PrivateAssets>All</PrivateAssets>
    </FrameworkReference>
  </ItemGroup>

  <!-- Embed Web assets into assembly manifest -->
  <ItemGroup>
    <None Remove="Web\**" />
    <EmbeddedResource Include="Web\**" />
  </ItemGroup>

</Project>
